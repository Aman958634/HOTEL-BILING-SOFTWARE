# Staging-only template. Configure values in the deployment secret store;
# do not copy this file to a live environment or place credentials in Git.
NODE_ENV=staging
PORT=5002

# Exact, non-production browser origin. It must also appear in ALLOWED_ORIGINS.
CLIENT_URL=https://staging-ui.example.invalid
ALLOWED_ORIGINS=https://staging-ui.example.invalid

# Inject the real staging URI only through the staging secret store. The
# hostname and database must match the guard values below exactly.
MONGO_URI=
STAGING_MONGODB_HOSTS=restospherestaging.50b7xma.mongodb.net
STAGING_PRODUCTION_MONGODB_HOSTS=cluster0.7fvxcg5.mongodb.net
STAGING_MONGODB_DATABASE=restosphere_staging

# Inject unique staging-only secrets through the secret store.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PUBLIC_MENU_CONTEXT_SECRET=
PUBLIC_MENU_ENABLED=true

# Staging never enables real payment collection. If Razorpay subscription
# checkout is deliberately tested, inject only rzp_test_* credentials.
LIVE_DIGITAL_PAYMENTS=false
BILLING_TEST_MODE=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_PAYMENTS_ENABLED=false
CASHFREE_EASY_SPLIT_ENABLED=false
CASHFREE_EASY_SPLIT_PAYMENTS_ENABLED=false
CASHFREE_SETTLEMENT_RECONCILIATION_ENABLED=false

# Keep backups/restores and automatic startup mutations disabled in staging.
BACKUP_ENABLED=false
ENABLE_BACKUP_RESTORE=false
BACKUP_RESTORE_MAINTENANCE_MODE=false
RUN_STARTUP_DATA_BOOTSTRAP=false
SUPER_ADMIN_SEED=false
WHATSAPP_ENABLED=false
