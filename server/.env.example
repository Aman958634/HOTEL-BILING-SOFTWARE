NODE_ENV=development
PORT=5002
# Comma-separated browser origins (include production Vercel URL)
CLIENT_URL=http://localhost:5173,https://hotel-biling-software.vercel.app
PUBLIC_MENU_ENABLED=true
# Set true only when real gateway payments are enabled; then configure either
# Razorpay or Stripe credentials below.
LIVE_DIGITAL_PAYMENTS=false
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/restaurant
BACKUP_ENABLED=true
BACKUP_HOUR_UTC=2
BACKUP_DIR=./backups
# Set only while an administrator is performing a planned restore.
ENABLE_BACKUP_RESTORE=false
# Optional absolute paths when MongoDB Database Tools are not on PATH.
MONGODUMP_PATH=mongodump
MONGORESTORE_PATH=mongorestore
JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
# Required in production for signed table QR menu contexts. Keep this distinct from JWT secrets.
PUBLIC_MENU_CONTEXT_SECRET=
PUBLIC_MENU_CONTEXT_EXPIRES=365d
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_EXPIRES=30d
FREE_TRIAL_DAYS=15
BILLING_TEST_MODE=true
# Super admin is auto-seeded on startup (idempotent) unless SUPER_ADMIN_SEED=false.
# Defaults match server/.env.example — override in production for stronger credentials.
SUPER_ADMIN_EMAIL=replace_with_super_admin_email
SUPER_ADMIN_PASSWORD=replace_with_a_long_unique_password
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_SEED=false
# Set SUPER_ADMIN_RESET_PASSWORD=true only to reset password for existing account via seed script
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email
EMAIL_PASS=your_email_password
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_webhook_secret
