# Staging build values. Set the actual staging HTTPS API host in the
# deployment platform; never substitute a production endpoint.
VITE_DEPLOYMENT_ENV=staging
VITE_API_URL=
VITE_SOCKET_URL=
# Comma-separated hostnames only, without a scheme or path. This is public
# build configuration, not a secret, and must contain the actual staging API host.
VITE_STAGING_API_HOSTS=
